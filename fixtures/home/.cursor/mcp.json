{
  "mcpServers": {
    "postgres": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-postgres", "postgresql://localhost/app"],
      "env": {
        "PGSSLMODE": "disable"
      }
    },
    "linear": {
      "type": "http",
      "url": "https://mcp.linear.app/mcp",
      "headers": {
        "Authorization": "Bearer your-linear-token"
      }
    },
    "figma": {
      "type": "sse",
      "url": "https://mcp.figma.com/sse",
      "disabled": true
    }
  }
}
